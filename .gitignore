# Agent tool config
.claude/
.cursor/
.agents/
.agent/
.gemini/
.github/skills/
.windsurf/
.clinerules/
CLAUDE.md
AGENTS.md
GEMINI.md

# Flags-used marker (0000020) - local per-tool install state, not source. Matches
# at any depth (e.g. .claude/.ravintio-setup-flags, .github/.ravintio-setup-flags)
# since most tool directories above are gitignored wholesale but .github/skills/
# and .opencode/ are narrower/absent patterns that would otherwise let this
# specific file slip through untracked-but-not-ignored.
.planifest-setup-flags
.ravintio-setup-flags

# Temporary local dirs
_temp/*
!_temp/.gitkeep

# Local-only working files - anything named *.local-only.* stays on this
# machine (helper scripts, scratch notes) and is never committed
*.local-only.*

# build-release.mjs work folders (0000041 ADR-003). An interrupted build
# leaves one behind, and it must never reach a commit.
.ravintio-framework-build/
.ravintio-framework-previous/

# OS
.DS_Store
